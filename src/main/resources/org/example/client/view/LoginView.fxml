<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.client.controller.LoginController"
      spacing="10" alignment="CENTER" styleClass="login-root">
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <Label text="ICQ Messenger" styleClass="login-title"/>
    <Label text="Подключение к серверу" styleClass="login-subtitle"/>

    <TextField fx:id="hostField" text="127.0.0.1" promptText="Адрес сервера"/>
    <TextField fx:id="portField" text="12345" promptText="Порт"/>
    <TextField fx:id="nickField" promptText="Ваш ник"/>

    <Button text="Войти" onAction="#onConnect" defaultButton="true" styleClass="primary-button"/>
    <Label fx:id="statusLabel" styleClass="status-label"/>
</VBox>
